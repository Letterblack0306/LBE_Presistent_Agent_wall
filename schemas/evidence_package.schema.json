{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letterblack.local/schemas/evidence_package.schema.json",
  "title": "LBE Guard Inspector Evidence Package",
  "type": "object",
  "required": [
    "package_id",
    "task_id",
    "query",
    "indexed_evidence",
    "workspace_evidence",
    "validation_evidence",
    "contradictions",
    "gaps",
    "generated_at"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "indexed_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "workspace_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "ref",
        "source_type",
        "authority",
        "verified",
        "classification"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "index",
            "workspace",
            "validation",
            "policy",
            "proof"
          ]
        },
        "record_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "exact_phrase": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "authority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "verified": {
          "type": "boolean"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "line_start": {
                "type": "integer"
              },
              "line_end": {
                "type": "integer"
              }
            },
            "required": [
              "line_start",
              "line_end"
            ]
          },
          "then": {
            "properties": {
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
