{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letterblack.local/schemas/authority_ownership_request.schema.json",
  "title": "Authority Ownership Request",
  "type": "object",
  "required": ["request_id", "workspace_id", "operation_id", "canonical_target"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "canonical_target": {"type": "string", "minLength": 1},
    "ownership_sensitive": {"type": "boolean", "default": true},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
