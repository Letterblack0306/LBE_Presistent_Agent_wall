{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letterblack.local/schemas/owner_authority_authorization.schema.json",
  "title": "Owner Authority Authorization",
  "type": "object",
  "required": ["issue_id", "owner_file_or_module", "owner_reason", "owner_evidence", "owner_status", "allowed_paths", "validation_command"],
  "properties": {
    "issue_id": {"type": "string", "minLength": 1},
    "owner_file_or_module": {"type": "string", "minLength": 1},
    "owner_reason": {"type": "string", "minLength": 1},
    "owner_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner_status": {"type": "string", "enum": ["OWNER_PROVEN", "OWNER_UNPROVEN", "OWNER_CONFLICT", "WRONG_SCOPE"]},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation_command": {"type": "string", "minLength": 1},
    "forbidden_layers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issue_layer": {"type": "string", "minLength": 1},
    "proposed_layer": {"type": "string", "minLength": 1},
    "conflicting_owner_candidates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
