{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letterblack.local/schemas/rule_proposal.schema.json",
  "title": "Workspace Rule Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "workspace_id",
    "rule_id",
    "pack_id",
    "target_profile_path",
    "trigger",
    "rationale",
    "scope",
    "required_action",
    "severity",
    "exceptions",
    "equivalent_rule_checked",
    "equivalent_rule_result",
    "contradiction_result",
    "evidence_refs",
    "diff",
    "validation_plan",
    "rollback_plan",
    "provenance",
    "approval_required",
    "created_at"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-[a-f0-9]{24}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "target_profile_path": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "blocking"
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "equivalent_rule_checked": {
      "const": true
    },
    "equivalent_rule_result": {
      "type": "string",
      "minLength": 1
    },
    "contradiction_result": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "diff": {
      "type": "string",
      "minLength": 1
    },
    "validation_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "mode",
        "generator",
        "workspace_root",
        "profile_path_source",
        "catalog_snapshot_hash",
        "evidence_hashes"
      ],
      "properties": {
        "mode": {
          "const": "propose-rule"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "profile_path_source": {
          "type": "string",
          "enum": [
            "explicit_request",
            "workspace_profile",
            "active_policy"
          ]
        },
        "catalog_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "approval_required": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
