{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letterblack.local/schemas/rule_proposal.schema.json",
  "title": "Workspace Rule Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "workspace_id",
    "rule_id",
    "trigger",
    "rationale",
    "scope",
    "required_action",
    "severity",
    "exceptions",
    "equivalent_rule_checked",
    "evidence_refs",
    "diff",
    "validation_plan",
    "rollback_plan",
    "approval_required",
    "created_at"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "blocking"
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equivalent_rule_checked": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "diff": {
      "type": "string",
      "minLength": 1
    },
    "validation_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "approval_required": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
